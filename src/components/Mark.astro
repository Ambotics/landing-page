---
// The Ambotics mark — the "A" cut in two, knocked out of a rounded tile.
//
// The drawing is `assets/mark.svg`. It is a file of its own because the robot's
// render script reads it too: the tile on the robot's chest in the hero is this
// path (see "The hero" in README.md).
//
// Drawn from the designer's 391px frame: a square with 20px corners and the A cut
// through it, so whatever sits behind the tile shows through the A. The A is moved
// 17px left and 1.36px up from the frame, which sat it right of centre; it is now
// centred on its own bounds. The fill is `currentColor`: the tile takes whatever
// colour the wordmark beside it has, white on the footer's blue.
import MarkSvg from '../assets/mark.svg';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<MarkSvg aria-hidden="true" class={className} />
