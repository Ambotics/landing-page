---
// The Ambotics mark — the "A" cut in two.
//
// Drawn from the designer's 391px frame (navy mark on a #185de4 square), with the
// square dropped and the viewBox cropped tight to the mark, so it sits on a text
// baseline like a glyph. The fill is `currentColor`: the mark takes whatever colour
// the wordmark beside it has, which keeps it grayscale in the sidebar and white on
// the footer's blue. The designer's navy (#202059) is deliberately not carried over —
// it would be a second blue on a page that allows exactly one.
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  viewBox="80.5 63.6 262.5 268.4"
  fill="currentColor"
  aria-hidden="true"
  class={className}
>
