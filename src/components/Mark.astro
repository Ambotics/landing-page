---
// The Ambotics mark — the "A" cut in two.
//
// Drawn from the designer's 391px frame (#185de4 mark on a #001b30 square), with
// the square dropped and the viewBox cropped tight to the mark, so it sits on a text
// baseline like a glyph. The fill is `currentColor`: the mark takes whatever colour
// the wordmark beside it has, which keeps it grayscale in the sidebar and white on
// the footer's blue. The designer's navy (#001b30) is deliberately not carried over —
// it would be a second blue on a page that allows exactly one.
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  viewBox="78 69.8 267.5 251.2"
  fill="currentColor"
  aria-hidden="true"
  class={className}
>
