---
// The Ambotics mark — the "A" cut in two, knocked out of a rounded tile.
//
// Drawn from the designer's 391px frame: a square with 20px corners and the A cut
// through it, so whatever sits behind the tile shows through the A. The A is moved
// 17px left and 1.36px up from the frame, which sat it right of centre; it is now
// centred on its own bounds. The fill is `currentColor`: the tile takes whatever
// colour the wordmark beside it has, which keeps it grayscale in the sidebar and
// white on the footer's blue.
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg viewBox="0 0 391 391" fill="currentColor" aria-hidden="true" class={className}>
  <path
    fill-rule="evenodd"
    d="M20 0H371A20 20 0 0 1 391 20V371A20 20 0 0 1 371 391H20A20 20 0 0 1 0 371V20A20 20 0 0 1 20 0Z
