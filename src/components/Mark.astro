---
// The Ambotics mark — the "A" cut in two.
//
// Drawn from the designer's 391px frame (navy square, white mark), with the square
// dropped and the viewBox cropped tight to the mark, so it sits on a text baseline
// like a glyph. The fill is `currentColor`: the mark takes whatever colour the
// wordmark beside it has, which keeps it grayscale in the sidebar and white on the
// footer's blue. The designer's navy (#202059) is deliberately not carried over —
// it would be a second blue on a page that allows exactly one.
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  viewBox="56.6 62 277.8 242"
  fill="currentColor"
  aria-hidden="true"
  class={className}
>
  <path
    d="M94.697 231.747L58.9676 293.644L57.3197 296.504C55.3989 299.837 57.8047 304 61.6519 304H176.455H226.448L184.774 231.747H94.697Z"
  ></path>
  <path
    d="M199.844 64.5073C197.92 61.172 193.106 61.1719 191.182 64.5071L148.314 138.809L192.898 211.031L246.545 304H329.343C333.192 304 335.597 299.835 333.674 296.502L199.844 64.5073Z"
  ></path>
</svg>
