---
// The Ambotics mark — the "A" cut in two.
//
// Drawn from the designer's 391px frame (the mark knocked out of a white rounded
// square), with the square dropped and the viewBox cropped tight to the mark, so it
// sits on a text baseline like a glyph. The fill is `currentColor`: the mark takes
// whatever colour the wordmark beside it has, which keeps it grayscale in the sidebar
// and white on the footer's blue.
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  viewBox="67.8 61 289.4 271.7"
  fill="currentColor"
  aria-hidden="true"
  class={className}
>
