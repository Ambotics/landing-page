---
// One section of the page: the heading in the first of three columns, the copy
// in the other two, and room under both for something wide. Every section goes
// through this component, so the columns line up down the page and the headings
// have one treatment.
//
// That treatment is the display face (Gabarito with `ss01`), the H1's own, a
// step down in size. Grayscale, like everything that is not a response state —
// a heading announces, it does not do anything. See "Design system" in README.md.
interface Props {
  id: string;
  heading: string;
}

const { id, heading } = Astro.props;
---

<section id={id} class="py-20 sm:py-28">
  <div class="mx-auto grid max-w-6xl gap-x-10 gap-y-8 px-6 lg:grid-cols-3 lg:px-10">
    <h2
      class="font-display ss01 text-3xl font-medium tracking-tight text-balance text-ink sm:text-4xl lg:sticky lg:top-10 lg:self-start"
    >
      {heading}
    </h2>
    <div class="lg:col-span-2">
      <slot />
    </div>
    {
      Astro.slots.has('wide') && (
        <div class="mt-6 min-w-0 lg:col-span-3">
          <slot name="wide" />
        </div>
      )
    }
  </div>
</section>
