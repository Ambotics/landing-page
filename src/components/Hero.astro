---
// The hero: the page opens on the mark, and scrolling zooms out until the mark
// is the tile on the robot's chest, with the headline over the robot. The head
// comes into view looking down at the robot's hands, then lifts to look at the
// visitor.
//
// The robot is five pictures from one camera with a zoom lens: the whole robot,
// then squares about the mark down to its tile. `zoom.json` says where each lies,
// in mm on the mark's plane from the mark's centre, so laid over each other they
// are one picture that stays sharp from the tile out to the robot. The head is
// pictures of its own through the same camera: looking down, then lifting to
// where the five have it, level, and from there looking around, for the head
// to turn after the visitor's pointer once the robot is at rest. All come from
// the robot's own render script (see "The hero" in README.md). The whole robot
// and the head's looks come twice, the second time twice as sharp: a large
// screen shows the robot at rest larger than its first picture.
//
// CSS lays out the resting state: headline, then the whole robot. The script
// only draws the zoom while the visitor scrolls through [data-travel], so
// without scripts, or where the visitor asked for less motion (the `zooming`
// variant in global.css), the page is the resting state.
import type { ImageMetadata } from 'astro';
import Mark from './Mark.astro';
import zoom from '../assets/hero/zoom.json';

const pictures = import.meta.glob<{ default: ImageMetadata }>('../assets/hero/**/*.webp', {
  eager: true,
});
const picture = (name: string) => pictures[`../assets/hero/${name}.webp`].default;

const [frame] = zoom.levels; // the whole robot
const robot = picture(frame.name);
const sources = {
  levels: zoom.levels.map(({ name }) => picture(name).src),
  // the head looking down, sharp, for while it comes into view
  head: picture('head').src,
  // the head lifting, the last as the levels have it
  frames: Array.from({ length: zoom.head.frames }, (_, i) =>
    picture(`head/${String(i).padStart(2, '0')}`).src
  ),
  // the head looking around: a picture for each row of looks, the highest first
  looks: zoom.look.ups.map((_, i) => picture(`look/${String(i).padStart(2, '0')}`).src),
  // the whole robot and the looks, twice as sharp
  sharper: {
    robot: picture('robot_2x').src,
    looks: zoom.look.ups.map((_, i) => picture(`look_2x/${String(i).padStart(2, '0')}`).src),
  },
};
---

<section data-hero>
  <div data-stage class="sticky top-0 overflow-hidden pb-16">
    <!-- The zoom is drawn here until the robot is at rest. A canvas because
         browsers disagree on scaling pictures this far (see "The hero" in
         CLAUDE.md). A screen and a half high: the first screen, and what
         scrolls into view while the zoom catches up with a fast scroll past its
         end. `lvh` so that holds on a phone once the toolbar has slid away. -->
    <canvas
      data-canvas
      data-pictures={JSON.stringify(sources)}
      class="pointer-events-none absolute top-0 left-0 hidden h-[150lvh] w-full zooming:block"
      aria-hidden="true"></canvas>

    <!-- The first screen. The cover is the mark, in the accent like its tile on
         the robot, on the chest cover's grey. CSS draws it at the size the zoom
         starts from, so the page opens on the mark before any picture has
         loaded; the script reads that size off it. The
         tile spans 30 of the 124 × 132 mm of plain cover around the mark, and
         that patch has to fill the screen: 30/124 of the width, 30/132 of the
         height, whichever is larger. -->
    <div data-view class="pointer-events-none absolute inset-x-0 top-0 z-20 hidden h-svh zooming:block">
      <div
        data-cover
        class="absolute inset-0 grid place-items-center bg-[#d6d7d5] transition-opacity duration-500"
      >
        <Mark class="w-[max(24.2vw,22.7svh)] text-accent" />
      </div>
      <p
        data-cue
        class="absolute inset-x-0 bottom-8 text-center font-ui text-sm font-medium tracking-[-0.01em] text-ink"
      >
        Scroll
        <span class="scroll-cue mx-auto mt-2 block h-8 w-px bg-ink"></span>
      </p>
    </div>

    <div
      data-reveal
      class="relative z-10 mx-auto max-w-6xl px-6 pt-24 text-center zooming:opacity-0 sm:pt-32 lg:px-10"
    >
      <h1
        class="mx-auto max-w-[20ch] font-display ss01 text-5xl font-medium tracking-tight text-balance text-ink sm:text-6xl lg:text-7xl"
      >
        A new kind of robotics company.
      </h1>
      <p class="mt-6 text-lg">
        <a
          href="#contact"
          class="font-medium text-ink underline decoration-ink/30 underline-offset-4 hover:decoration-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        >
          Get in touch
        </a>
      </p>
    </div>

    <!-- The robot at rest, in the whole robot's frame. Wider than a phone's
         screen on purpose: the frame's margins are empty, and the robot itself
         then spans most of the screen. While the zoom runs the canvas draws the
         robot and this picture is transparent. -->
    <img
      data-robot
      src={robot.src}
      width={robot.width}
      height={robot.height}
      alt="A two-armed robot on a lifting column and a wheeled base, the Ambotics mark on its chest."
      decoding="sync"
      draggable="false"
      class="relative left-1/2 -mt-6 aspect-(--frame) w-[min(125vw,78svh)] max-w-none -translate-x-1/2 select-none zooming:opacity-0"
      style={`--frame:${frame.w}/${frame.h}`}
    />

    <!-- The head at rest, turned after the visitor's pointer: a look of the
         head, drawn over the robot's own. The script puts it there. -->
    <canvas data-look class="pointer-events-none absolute hidden zooming:block" aria-hidden="true"
    ></canvas>
  </div>

  <!-- How far the visitor scrolls while the stage above stays put and zooms. -->
  <div data-travel class="hidden h-[260svh] zooming:block" aria-hidden="true"></div>
</section>

<script>
  import {
    mark,
    levels as fields,
    head as headField,
    look as lookField,
  } from '../assets/hero/zoom.json';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const part = <T extends HTMLElement = HTMLElement>(name: string) =>
    hero!.querySelector<T>(`[data-${name}]`)!;

  // The `zooming` variant's condition, from global.css: where it does not hold,
  // the page stays at rest. Asked of the browser, not read off the page: Safari
  // runs this before the stylesheet is in.
  const zooming = '(prefers-reduced-motion: no-preference) and (scripting: enabled)';

  if (hero && matchMedia(zooming).matches) {
    const stage = part('stage');
    const canvas = part<HTMLCanvasElement>('canvas');
    const view = part('view');
    const cover = part('cover');
    const cue = part('cue');
    const reveal = part('reveal');
    const robot = part('robot');
    const headCanvas = part<HTMLCanvasElement>('look');
    const travel = part('travel');
    const tile = cover.querySelector('svg')!;
    const context = canvas.getContext('2d')!;
    const headContext = headCanvas.getContext('2d')!;
    const [frame] = fields;

    const clamp = (n: number) => Math.min(Math.max(n, 0), 1);
    // Fast off the mark, slow onto the robot.
    const ease = (p: number) => 1 - (1 - p) ** 1.5;
    // The head starts to lift once the whole of it is in view on a laptop, and
    // looks at the visitor just before the robot is at rest.
    const lifted = (p: number) => {
      const t = clamp((p - 0.55) / 0.4);
      return t * t * (3 - 2 * t);
    };
    // From there it turns after the pointer, all the way once the robot is at
    // rest.
    const turned = (p: number) => clamp((p - 0.95) / 0.05);

    // All in CSS px, from the stage's top left corner.
    let rest = 1; // px per mm at rest
    let x = 0; // the mark's centre at rest
    let y = 0;
    let start = 1; // how many times larger the zoom starts
    let dx = 0; // from the mark at rest to the middle of the first screen
    let dy = 0;
    let ratio = 1; // canvas px per CSS px
    let page = ''; // the page's colour

    const measure = () => {
      const s = stage.getBoundingClientRect();
      const r = robot.getBoundingClientRect();
      rest = r.width / frame.w;
      x = r.left - s.left - frame.x * rest;
      y = r.top - s.top - frame.y * rest;
      start = tile.getBoundingClientRect().width / mark / rest;
      dx = view.offsetWidth / 2 - x;
      dy = view.offsetHeight / 2 - y;
      // No more than 16 million pixels: iOS draws nothing on a larger canvas.
      ratio = Math.min(devicePixelRatio, Math.sqrt(16e6 / (canvas.clientWidth * canvas.clientHeight)));
      canvas.width = canvas.clientWidth * ratio;
      canvas.height = canvas.clientHeight * ratio;
      // The head at rest lies over the robot's own, as sharp as the screen.
      page = getComputedStyle(document.body).backgroundColor;
      const { style } = headCanvas;
      style.left = `${x + lookField.x * rest}px`;
      style.top = `${y + lookField.y * rest}px`;
      style.width = `${lookField.w * rest}px`;
      style.height = `${lookField.h * rest}px`;
      headCanvas.width = Math.round(lookField.w * rest * devicePixelRatio);
      headCanvas.height = Math.round(lookField.h * rest * devicePixelRatio);
    };

    // Where the head looks, in degrees to the right and up from straight ahead.
    const gaze = { pan: 0, up: 0 };
    // The head as it looks that way. There is a look every few degrees. On the
    // way from one to the next the head is the nearer of them, moved to where
    // the head is by then, so it stays sharp and moves evenly: a blend of two
    // looks is two heads. What stands still under the neck stays where it is,
    // and the neck between is stretched.
    const posed = document.createElement('canvas');
    const pose = posed.getContext('2d')!;
    const look = (pan: number, up: number) => {
      const { y: top, w, pans, ups, eyes, chins, neck } = lookField;
      const column = (pan - pans[0]) / (pans[1] - pans[0]);
      const row = (ups[0] - up) / (ups[0] - ups[1]);
      const c = Math.round(column);
      const r = Math.round(row);
      const side = looks[0].naturalWidth / pans.length;
      const height = looks[0].naturalHeight;
      const px = side / w; // the look's own, per mm

      // How far the eyes are from where this look has them: between four
      // looks they are between those looks' eyes.
      const c0 = Math.min(Math.floor(column), pans.length - 2);
      const r0 = Math.min(Math.floor(row), ups.length - 2);
      const between = (i: number) => {
        const along = (r: number) =>
          eyes[r][c0][i] + (eyes[r][c0 + 1][i] - eyes[r][c0][i]) * (column - c0);
        return along(r0) + (along(r0 + 1) - along(r0)) * (row - r0);
      };
      const dx = (between(0) - eyes[r][c][0]) * px;
      const dy = (between(1) - eyes[r][c][1]) * px;

      // In strips from the top. The head down to its chin moves whole, the neck
      // under it less the lower, a row of px at a time, and from where the neck
      // stands still nothing moves. Each strip runs a px into the next, so none
      // shows a seam.
      const chin = Math.round((chins[r][c] - top) * px);
      const still = Math.round((neck - top) * px);
      const moved = (y: number) => clamp((still - y) / (still - chin));
      const edges = [0, ...Array.from({ length: still - chin + 1 }, (_, i) => chin + i), height];
      posed.width = side; // which clears it too
      posed.height = height;
      edges.slice(1).forEach((end, i) => {
        const from = edges[i];
        const to = Math.min(end + 1, height);
        const at = from + dy * moved(from);
        pose.drawImage(
          looks[r],
          c * side,
          from,
          side,
          to - from,
          dx * moved((from + end) / 2),
          at,
          side,
          to + dy * moved(to) - at
        );
      });
      return posed;
    };

    // A picture of the head goes over the robot's own head, with the mark's
    // centre at left, top and px to the mm. That head goes first, from inside
    // the picture's faded edge: the edge is 6% of the picture's longer side,
    // and 8% is left. It is cleared, or painted over where it is not on this
    // canvas.
    const replace = (
      onto: CanvasRenderingContext2D,
      picture: CanvasImageSource,
      { x, y, w, h }: { x: number; y: number; w: number; h: number },
      left: number,
      top: number,
      px: number,
      paint?: string
    ) => {
      const edge = 0.08 * Math.max(w, h);
      const inside = [
        left + (x + edge) * px,
        top + (y + edge) * px,
        (w - 2 * edge) * px,
        (h - 2 * edge) * px,
      ] as const;
      if (paint) {
        onto.fillStyle = paint;
        onto.fillRect(...inside);
      } else {
        onto.clearRect(...inside);
      }
      onto.globalAlpha = 1;
      onto.drawImage(picture, left + x * px, top + y * px, w * px, h * px);
    };

    const draw = (p: number) => {
      const arrived = clamp((p - 0.85) / 0.15);
      reveal.style.opacity = String(arrived);
      reveal.style.transform = `translateY(${(1 - arrived) * 16}px)`;
      cue.style.opacity = String(1 - clamp(p / 0.03));

      // At rest the picture in the page takes over: it reaches to the robot's
      // feet, the canvas does not.
      robot.style.opacity = p === 1 ? '1' : '0';
      canvas.style.visibility = p === 1 ? 'hidden' : 'visible';
      headCanvas.style.visibility = p === 1 && watching ? 'visible' : 'hidden';
      if (p === 1) {
        if (watching) {
          // The robot's own head is in the picture under this canvas, so the
          // page's colour hides it.
          const { x, y, w, h } = lookField;
          headContext.setTransform(headCanvas.width / w, 0, 0, headCanvas.height / h, 0, 0);
          headContext.imageSmoothingQuality = 'high';
          headContext.clearRect(0, 0, w, h);
          replace(headContext, look(gaze.pan, gaze.up), lookField, -x, -y, 1, page);
        }
        return;
      }

      const scale = start ** (1 - ease(p));
      // The mark moves to its resting place in step with the scale: one zoom
      // about one point of the screen, not a zoom and a pan.
      const moved = start === 1 ? 0 : (scale - 1) / (start - 1);
      const px = rest * scale; // per mm
      const left = x + dx * moved; // the mark's centre
      const top = y + dy * moved;

      // How much of each picture shows. A closer one comes in once the one
      // under it would be stretched.
      const shown = pictures.map((picture, i) => {
        if (!picture.naturalWidth) return 0;
        if (!i) return 1;
        const under = pictures[i - 1].naturalWidth / fields[i - 1].w; // its px per mm
        return clamp(((px * ratio) / under - 1) / 0.4);
      });
      // What a picture hides is not drawn: one that shows in full and fills the
      // canvas inside its faded edge. The edge is 6% a side; 8% is left out.
      const { clientWidth, clientHeight } = canvas;
      const fills = (i: number) => {
        const { x, y, w, h } = fields[i];
        return (
          shown[i] === 1 &&
          left + (x + 0.08 * w) * px <= 0 &&
          top + (y + 0.08 * h) * px <= 0 &&
          left + (x + 0.92 * w) * px >= clientWidth &&
          top + (y + 0.92 * h) * px >= clientHeight
        );
      };
      const lowest = Math.max(0, shown.findLastIndex((_, i) => fills(i)));

      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      context.clearRect(0, 0, clientWidth, clientHeight);
      pictures.slice(lowest).forEach((picture, n) => {
        const i = lowest + n;
        if (!shown[i]) return;
        const { x, y, w, h } = fields[i];
        context.globalAlpha = shown[i];
        context.drawImage(picture, left + x * px, top + y * px, w * px, h * px);
      });

      // The head. Its last picture is the head the pictures above already
      // show, so that one is not drawn. The first has a sharp copy.
      const lift = Math.round(lifted(p) * (heads.length - 1));
      const close = !lift && px * ratio > 1.2 * (heads[0].naturalWidth / headField.w);
      const head = close && sharp.naturalWidth ? sharp : heads[lift];
      if (lift < heads.length - 1 && head.naturalWidth) {
        replace(context, head, headField, left, top, px);
      }
      // The head on its way to the pointer, or back from it.
      if (watching && (gaze.pan || gaze.up)) {
        replace(context, look(gaze.pan, gaze.up), lookField, left, top, px);
      }
    };

    const scrolled = () =>
      clamp(-hero.getBoundingClientRect().top / (travel.offsetHeight || 1));

    // The look that points the head at the pointer, as if the pointer hung
    // `reach` mm in front of the robot: straight ahead until the looks are in,
    // and when the pointer has left the page. Short of rest the head turns
    // part of the way, and that is a look as well: the scroll can stop there,
    // and between two looks the head is a blur.
    const reach = 700;
    let watching = false;
    let pointer: { x: number; y: number } | undefined;
    const aim = (p: number) => {
      if (!watching || !pointer || !turned(p)) return { pan: 0, up: 0 };
      const s = stage.getBoundingClientRect();
      const { pans, ups, eyes } = lookField;
      const [eyesX, eyesY] = eyes[ups.indexOf(0)][pans.indexOf(0)]; // looking straight ahead
      const angle = (px: number) =>
        (turned(p) * Math.atan(px / rest / reach) * 180) / Math.PI;
      const nearest = (list: number[], to: number) =>
        list.reduce((a, b) => (Math.abs(b - to) < Math.abs(a - to) ? b : a));
      return {
        pan: nearest(pans, angle(pointer.x - s.left - x - eyesX * rest)),
        up: nearest(ups, angle(s.top + y + eyesY * rest - pointer.y)),
      };
    };

    // The zoom follows the scroll a few frames behind, so a mouse wheel's steps
    // come out as one movement. It closes in faster past the end of the travel:
    // the stage then scrolls on, and the canvas stops half a screen further down.
    // The head follows its aim the same way, most of the turn in a fifth of a
    // second.
    let p = 0;
    let frameId = 0;
    let before = 0; // when the last frame was, while frames follow each other
    const follow = (now: number) => {
      const to = scrolled();
      p += (to - p) * (to === 1 ? 0.5 : 0.25);
      if (Math.abs(to - p) < 0.0005) p = to;
      const at = aim(p);
      const closer = 1 - Math.exp(-Math.min(now - (before || now - 16), 50) / 80);
      gaze.pan += (at.pan - gaze.pan) * closer;
      gaze.up += (at.up - gaze.up) * closer;
      if (Math.hypot(at.pan - gaze.pan, at.up - gaze.up) < 0.1) Object.assign(gaze, at);
      draw(p);
      const there = p === to && gaze.pan === at.pan && gaze.up === at.up;
      frameId = there ? 0 : requestAnimationFrame(follow);
      before = there ? 0 : now;
    };
    const wake = () => {
      frameId ||= requestAnimationFrame(follow);
    };
    addEventListener('scroll', wake, { passive: true });

    // A mouse wheel says where the pointer is too, before it has moved. A
    // finger is no pointer: it is on the screen only while it scrolls.
    let pointed = () => {};
    const hasPointer = new Promise<void>((resolve) => (pointed = resolve));
    const see = (event: PointerEvent | WheelEvent) => {
      if ('pointerType' in event && event.pointerType === 'touch') return;
      pointer = { x: event.clientX, y: event.clientY };
      pointed();
      // only where the head turns, and not once it has scrolled off the screen
      if (watching && turned(p) && stage.getBoundingClientRect().bottom > 0) wake();
    };
    addEventListener('pointermove', see, { passive: true });
    addEventListener('wheel', see, { passive: true });
    document.documentElement.addEventListener('pointerleave', () => {
      pointer = undefined;
      wake();
    });

    // The resting state moves when the screen is resized, when the stylesheet
    // comes in and when the headline's font does. The observer also runs once
    // at the start.
    const resting = new ResizeObserver(() => {
      measure();
      p = scrolled();
      draw(p);
      sharpen();
    });
    resting.observe(stage);
    resting.observe(view);

    // The pictures, each drawn as soon as it is in. The cover goes once the
    // closer ones are: the first screen is theirs. The head's frames come
    // after, and its looks last, once there is a pointer to look at.
    const sources: {
      levels: string[];
      head: string;
      frames: string[];
      looks: string[];
      sharper: { robot: string; looks: string[] };
    } = JSON.parse(canvas.dataset.pictures!);
    const load = (src: string) => {
      const picture = Object.assign(new Image(), { src });
      const loaded = picture.decode().then(
        () => draw(p),
        () => {}
      );
      return { picture, loaded };
    };
    const levels = sources.levels.map(load);
    const pictures = levels.map(({ picture }) => picture);
    const { picture: sharp, loaded: sharpLoaded } = load(sources.head);
    const heads = sources.frames.map(() => new Image());
    const looks = sources.looks.map(() => new Image());

    // Whether the screen shows the robot at rest with a fifth more px than its
    // picture has, or more: then the picture twice as sharp is wanted. Not
    // before the stylesheet is in: until then the robot is as large as its
    // picture, and Safari runs this that early.
    const own = Number(robot.getAttribute('width')) / frame.w; // the picture's px per mm
    const large = () =>
      getComputedStyle(stage).position === 'sticky' && rest * devicePixelRatio > 1.2 * own;
    // The sharper robot takes the first one's place, in the page and in the
    // zoom, once the first screen is up. A window made larger can come to want
    // it, so the observer above asks again.
    let up = false;
    let sharpened = false;
    const sharpen = () => {
      if (!up || sharpened || !large()) return;
      sharpened = true;
      const { picture, loaded } = load(sources.sharper.robot);
      loaded.then(() => {
        if (!picture.naturalWidth) return;
        pictures[0] = picture;
        robot.setAttribute('src', picture.src);
        draw(p);
      });
    };

    const lift = Promise.all([
      ...levels.slice(1).map(({ loaded }) => loaded),
      sharpLoaded,
    ]).then(() => {
      cover.style.opacity = '0';
      up = true;
      sharpen();
      return Promise.all(
        sources.frames.map((src, i) =>
          Object.assign(heads[i], { src })
            .decode()
            .then(
              () => draw(p),
              () => {}
            )
        )
      );
    });
    // The sharper looks are large: ten of them decoded at once are 280 MB. So
    // those are only fetched here, and each is decoded when the head first
    // needs it.
    const fetched = (picture: HTMLImageElement, src: string) =>
      new Promise<void>((resolve, reject) => {
        picture.onload = () => resolve();
        picture.onerror = reject;
        picture.src = src;
      });
    Promise.all([lift, hasPointer])
      .then(() =>
        Promise.all(
          large()
            ? sources.sharper.looks.map((src, i) => fetched(looks[i], src))
            : sources.looks.map((src, i) => Object.assign(looks[i], { src }).decode())
        )
      )
      .then(
        () => {
          watching = true;
          wake();
        },
        () => {}
      );
  }
</script>
