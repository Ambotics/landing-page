---
import Wordmark from './Wordmark.astro';

const year = 2026;
---

<footer class="px-[10px] pb-[10px]">
  <div
    class="relative flex min-h-[60vh] items-center overflow-hidden rounded-[24px] bg-accent"
  >
    <div class="footer-noise" aria-hidden="true"></div>
    <div
      class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col gap-10 px-6 py-24 sm:flex-row sm:items-center sm:justify-between sm:px-10 lg:px-[74px]"
    >
      <Wordmark class="text-[28px] font-semibold text-white" />
      <div
        class="font-body text-[13px] leading-[1.6] tracking-[-0.01em] text-white/85 sm:text-right"
      >
        <p>Ambotics ApS © {year}</p>
        <p>Siljangade 1, 2300 Copenhagen S</p>
      </div>
    </div>
  </div>
</footer>
