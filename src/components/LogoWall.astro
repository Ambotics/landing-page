---
// Logo wall — companies the team has worked with on robotics.
//
// The heading says "Our team has worked with", not "our customers": these are the
// people's prior engagements, not Ambotics accounts, and the wall must not be
// readable as a client list.
//
// Colour: every logo is bound to `currentColor`, so the wall idles at `nav` and
// warms to `ink` — the same idle/active pair the sidebar links use. That is the
// grayscale-default rule applied to artwork we did not draw. Desaturating the
// brand colours instead does NOT work: CSS grayscale() preserves each mark's own
// luminance, which put AstraZeneca's near-black plum and Universal Robots' light
// blue four stops apart on the same row. See "Design system" in README.md.
import { partners } from '../data/partners';
---

<section id="experience" class="mt-24 max-w-content">
  <!-- `ink`, not `nav`: nav on page is 3.59:1, which is under AA for real text.
       The logos may sit at nav — WCAG exempts logotypes from contrast — but this
       label may not. -->
  <h2 class="font-ui text-[12px] font-medium uppercase tracking-[0.08em] text-ink">
    Our team has worked with
  </h2>

  <ul class="mt-7 flex flex-wrap items-center gap-x-12 gap-y-8 text-nav">
    {
      partners.map(({ name, svg, height }) => (
        <li class="logo transition-colors duration-300 hover:text-ink" style={`height:${height}px`}>
          <span class="sr-only">{name}</span>
          <Fragment set:html={svg} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* `set:html` output carries no scoping attribute, so reach it with :global. */
  .logo :global(svg) {
    display: block;
    height: 100%;
    width: auto;
    /* Guard rail, not a treatment: the logos are already bound to currentColor,
       so this is a no-op today. It exists so a future logo dropped in with its
       brand palette intact cannot quietly put a second colour on the page. */
    filter: grayscale(1);
  }
</style>
