---
// Logo wall — companies the team has worked with on robotics.
//
// It closes the Applications section: the carousel shows the kinds of work, and
// the marks underneath say where the people doing it have already done it.
//
// The heading says "With experience from", not "our customers": these are the
// people's prior engagements, not Ambotics accounts, and a bare logo strip reads
// as a client list unless the wording rules it out.
//
// Colour: every logo is bound to `currentColor`, so the wall idles at `nav` and
// warms to `ink` — the same idle/active pair the sidebar links use. That is the
// grayscale-default rule applied to artwork we did not draw. Desaturating the
// brand colours instead does NOT work: CSS grayscale() preserves each mark's own
// luminance, which put AstraZeneca's near-black plum and Universal Robots' light
// blue four stops apart on the same row. See "Design system" in README.md.
import SectionHeading from './SectionHeading.astro';
import { partners } from '../data/partners';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<section id="experience" class:list={['max-w-content', className]}>
  <!-- h3, not h2: this sits inside the Applications section, and the outline
       should say so even though the treatment is identical. -->
  <SectionHeading as="h3">With experience from</SectionHeading>

  <!-- `justify-between` spans the row across the container so its edges line up
       with the copy above it, instead of the marks bunching at the left.

       `gap-x-12` stays because it is the wrap floor, not the spacing: with these
       four marks (288px of logo in total) the row holds one line down to a 432px
       container and then breaks, which is the same point it broke at before —
       justify-between changes how each row distributes, never how many rows
       there are. Below ~356px it settles into a flush 2×2. -->
  <ul
    class="mt-7 flex flex-wrap items-center justify-between gap-x-12 gap-y-8 text-nav"
  >
    {
      partners.map(({ name, svg, height }) => (
        <li class="logo transition-colors duration-300 hover:text-ink" style={`height:${height}px`}>
          <span class="sr-only">{name}</span>
          <Fragment set:html={svg} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* `set:html` output carries no scoping attribute, so reach it with :global. */
  .logo :global(svg) {
    display: block;
    height: 100%;
    width: auto;
    /* Guard rail, not a treatment: the logos are already bound to currentColor,
       so this is a no-op today. It exists so a future logo dropped in with its
       brand palette intact cannot quietly put a second colour on the page. */
    filter: grayscale(1);
  }
</style>
