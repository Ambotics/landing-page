---
// No backend yet — the form is inert, exactly as in the original page.
// Point `action` at a form handler (Formspree, Buttondown, a Worker, …) to make it live.
//
// Labels are visible rather than `sr-only` placeholders. A four-field form loses
// its placeholder text the moment someone types, and "which box was the company
// one" is a real question on a form this plain; the single-field pill this
// replaced could get away with it because there was nothing to confuse it with.
//
// The labels are `ink`, not `nav` — including the "(optional)" qualifier, which
// is real text and so cannot sit at nav's 3.59:1 on the page. It is set apart by
// weight instead of colour. Same rule as the logo wall's heading.
import SectionHeading from './SectionHeading.astro';

const fields = [
  { id: 'name', label: 'Name', type: 'text', autocomplete: 'name', wide: false },
  { id: 'email', label: 'Email', type: 'email', autocomplete: 'email', wide: false },
  { id: 'company', label: 'Company', type: 'text', autocomplete: 'organization', wide: true },
] as const;

const labelClass =
  'block font-ui text-[12px] font-medium tracking-[-0.01em] text-ink';
const controlClass =
  'mt-2 w-full rounded-xl bg-field px-4 py-3 font-sat text-[15px] tracking-[-0.01em] text-ink outline-none transition-shadow focus:ring-2 focus:ring-accent/35';
---

<!-- mt-24, matching the gap between top-level sections. Applications now ends
     with a 64px-spaced subsection ("Where to start"), so at mt-16 the form read
     as one more block inside it rather than as the next section. -->
<section id="contact" class="mt-24 max-w-content">
  <SectionHeading class="mb-5">Get in touch</SectionHeading>

  <form data-notify>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        fields.map(({ id, label, type, autocomplete, wide }) => (
          <div class:list={[wide && 'sm:col-span-2']}>
            <label for={id} class={labelClass}>
              {label}
            </label>
            <input
              id={id}
              name={id}
              type={type}
              autocomplete={autocomplete}
              required
              class={controlClass}
            />
          </div>
        ))
      }

      <div class="sm:col-span-2">
        <label for="message" class={labelClass}>
          Message <span class="font-normal">(optional)</span>
        </label>
        <textarea id="message" name="message" rows="4" class={`${controlClass} resize-y`}
        ></textarea>
      </div>
    </div>

    <button
      type="submit"
      class="mt-5 rounded-full bg-ink px-5 py-[10px] font-sat text-[14px] font-medium tracking-[-0.01em] text-white shadow-[0_1px_2px_rgba(0,0,0,0.06)] transition-[background-color,transform] hover:bg-ink-hover active:scale-[0.98]"
    >
      Send
    </button>
  </form>
</section>

<script>
  document.querySelector<HTMLFormElement>('form[data-notify]')?.addEventListener(
    'submit',
    (event) => event.preventDefault()
  );
</script>
