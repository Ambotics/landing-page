---
import Mark from './Mark.astro';

interface Props {
  href?: string;
  class?: string;
}

const { href, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'span';

// The mark is on /preview only until it is signed off. To promote it, drop this
// check and the matching one in Layout.astro, then delete src/pages/preview.astro.
const preview = Astro.url.pathname.startsWith('/preview');
---

<Tag
  href={href}
  class:list={['font-display ss01 leading-none tracking-[-0.02em]', className]}
>
  {
    // Sized in em so the lockup scales with whatever size the wordmark is set at.
    // `align-baseline` puts the mark's flat foot on the text baseline.
    preview && <Mark class="mr-[0.28em] inline-block h-[0.8em] w-auto align-baseline" />
  }Ambotics<sup class="text-[0.42em] align-super tracking-normal">™</sup>
</Tag>
